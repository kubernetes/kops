{
  "Statement": [
    {
      "Action": "ec2:DescribeInstanceTypes",
      "Effect": "Allow",
      "Resource": "*"
    },
    {
      "Action": "ec2:ModifyInstanceAttribute",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/KubernetesCluster": "privatekindnet.example.com"
        }
      },
      "Effect": "Allow",
      "Resource": "*"
    }
  ],
  "Version": "2012-10-17"
}
