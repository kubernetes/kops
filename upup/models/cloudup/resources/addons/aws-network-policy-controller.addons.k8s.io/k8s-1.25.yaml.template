kind: Deployment
metadata:
  name: amazon-network-policy-controller-k8s
  namespace: kube-system
  labels:
    app.kubernetes.io/instance: amazon-network-policy-controller-k8s
    app.kubernetes.io/name: amazon-network-policy-controller-k8s
spec:
  replicas: {{ ControlPlaneControllerReplicas false }}
  selector:
    matchLabels:
      app.kubernetes.io/name: amazon-network-policy-controller-k8s
      app.kubernetes.io/instance: amazon-network-policy-controller-k8s
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 25%
      maxUnavailable: 25%
  template:
    metadata:
      labels:
        app.kubernetes.io/name: amazon-network-policy-controller-k8s
        app.kubernetes.io/instance: amazon-network-policy-controller-k8s
    spec:
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
            - matchExpressions:
              - key: node-role.kubernetes.io/control-plane
                operator: Exists
      containers:
      - name: amazon-network-policy-controller-k8s
        image: "{{- or .Networking.AmazonVPC.NetworkPolicyControllerImage "602401143452.dkr.ecr.us-west-2.amazonaws.com/eks/amazon-network-policy-controller-k8s:v1.1.10-eksbuild.1" }}"
        imagePullPolicy: IfNotPresent
        args:
          - --enable-configmap-check=false
        livenessProbe:
          httpGet:
            path: /healthz
            port: 8081
          initialDelaySeconds: 15
          periodSeconds: 20
        readinessProbe:
          httpGet:
            path: /readyz
            port: 8081
          initialDelaySeconds: 5
          periodSeconds: 10
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
        resources:
          limits:
            memory: 1Gi
          requests:
            memory: 30Mi
            cpu: 0.3
      priorityClassName: system-cluster-critical
      serviceAccountName: amazon-network-policy-controller-k8s
      terminationGracePeriodSeconds: 10
      tolerations:
      - key: node-role.kubernetes.io/control-plane
        operator: Exists
      topologySpreadConstraints:
      - labelSelector:
          matchLabels:
            app.kubernetes.io/instance: amazon-network-policy-controller-k8s
            app.kubernetes.io/name: amazon-network-policy-controller-k8s
        maxSkew: 1
        topologyKey: kubernetes.io/hostname
        whenUnsatisfiable: DoNotSchedule
